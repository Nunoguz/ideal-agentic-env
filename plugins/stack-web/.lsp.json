{
  "typescript": {
    "command": "typescript-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".mts": "typescript",
      ".cts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".mjs": "javascript",
      ".cjs": "javascript",
      ".jsx": "javascriptreact",
      ".vue": "vue"
    },
    "initializationOptions": {
      "plugins": [{ "name": "@vue/typescript-plugin", "location": ".", "languages": ["vue"] }]
    }
  }
}
