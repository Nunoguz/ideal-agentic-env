#!/usr/bin/env node
// Change audit (ideal-agentic-env/governance). Detective control for change management (SOC 2 CC8.1,
// ISO 27001 A.8.32). It runs on every push to the default branch and checks two things for each new
// commit:
//   - the commit came from a merged pull request,
//   - that pull request's head commit had green checks.
// A violation fails the run. With OPEN_ISSUE=true it also opens a "[change-control]" issue, so the
// exception is recorded and reviewed.
// Environment: GITHUB_TOKEN, GITHUB_REPOSITORY, GITHUB_REF, GITHUB_EVENT_PATH (all set by Actions),
// OPEN_ISSUE, REQUIRE_APPROVAL.
import { appendFileSync, readFileSync, realpathSync } from "node:fs";
import { fileURLToPath } from "node:url";

const OK_CONCLUSIONS = new Set(["success", "neutral", "skipped"]);
const RETRYABLE = new Set([429, 500, 502, 503, 504]);
const MAX_PAGES = 5;
const short = (sha) => String(sha ?? "").slice(0, 7);
const realSleep = (ms) => new Promise((r) => setTimeout(r, ms));

export function makeApi({ token, base = "https://api.github.com", fetchImpl = fetch, sleep = realSleep }) {
  return async function api(path, { method = "GET", body } = {}) {
    for (let attempt = 1; ; attempt++) {
      const res = await fetchImpl(`${base}${path}`, {
        method,
        headers: {
          Accept: "application/vnd.github+json",
          Authorization: `Bearer ${token}`,
          "X-GitHub-Api-Version": "2022-11-28",
          ...(body ? { "Content-Type": "application/json" } : {}),
        },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (res.ok) return res.status === 204 ? null : res.json();
      if (attempt >= 3 || !RETRYABLE.has(res.status)) throw new Error(`GitHub API ${method} ${path} returned ${res.status}`);
      await sleep(2000 * attempt);
    }
  };
}

/** The commits a push added. The compare API returns at most 250; the rest are reported, not audited. */
export async function pushedCommits(api, repo, event) {
  if (/^0+$/.test(event.before ?? "")) return { commits: [event.after], created: true, note: "branch created: only the head commit is audited" };
  const cmp = await api(`/repos/${repo}/compare/${event.before}...${event.after}`);
  const commits = (cmp.commits ?? []).map((c) => c.sha);
  const note = cmp.total_commits > commits.length ? `only ${commits.length} of ${cmp.total_commits} commits were audited` : null;
  return { commits, created: false, note };
}

/** The merged pull request into `branch` that contains `sha`. Retries briefly: the association can lag the push. */
export async function mergedPullFor(api, repo, sha, branch, { attempts = 3, sleep = realSleep } = {}) {
  for (let i = 0; i < attempts; i++) {
    const pulls = await api(`/repos/${repo}/commits/${sha}/pulls`);
    const pr = (pulls ?? []).find((p) => p.merged_at && p.base?.ref === branch);
    if (pr) return pr;
    if (i < attempts - 1) await sleep(5000);
  }
  return null;
}

/** The newest run of each check (per app and name). A re-run supersedes the runs before it, for example
 *  a compliance run that `concurrency` cancelled when the PR description was edited and that ran again. */
export function latestRuns(runs) {
  const newest = new Map();
  const when = (r) => Date.parse(r.started_at ?? r.completed_at ?? "") || 0;
  for (const run of runs) {
    const key = `${run.app?.id ?? ""}:${run.name}`;
    const seen = newest.get(key);
    if (!seen || when(run) > when(seen) || (when(run) === when(seen) && (run.id ?? 0) > (seen.id ?? 0))) newest.set(key, run);
  }
  return [...newest.values()];
}

/**
 * The checks of a PR head as they stood at merge. Runs that started after `mergedAt` are left out: an event
 * that arrives as the PR merges (marking it ready, editing it) starts runs the merge did not wait for.
 */
export async function checksOf(api, repo, sha, mergedAt = null) {
  const failing = [];
  const pending = [];
  let total = 0;
  const all = [];
  for (let page = 1; page <= MAX_PAGES; page++) {
    const r = await api(`/repos/${repo}/commits/${sha}/check-runs?per_page=100&page=${page}`);
    const runs = r?.check_runs ?? [];
    all.push(...runs);
    if (runs.length < 100) break;
  }
  const cutoff = Date.parse(mergedAt ?? "");
  const beforeMerge = Number.isFinite(cutoff) ? all.filter((r) => !(Date.parse(r.started_at ?? "") > cutoff)) : all;
  for (const run of latestRuns(beforeMerge)) {
    total++;
    if (run.status !== "completed") pending.push(run.name);
    else if (!OK_CONCLUSIONS.has(run.conclusion)) failing.push(`${run.name} (${run.conclusion})`);
  }
  const combined = await api(`/repos/${repo}/commits/${sha}/status`);
  for (const s of combined?.statuses ?? []) {
    total++;
    if (s.state === "pending") pending.push(s.context);
    else if (s.state !== "success") failing.push(`${s.context} (${s.state})`);
  }
  return { total, failing, pending };
}

export async function approvedByOther(api, repo, pr) {
  const reviews = await api(`/repos/${repo}/pulls/${pr.number}/reviews?per_page=100`);
  return (reviews ?? []).some((r) => r.state === "APPROVED" && r.user?.login !== pr.user?.login);
}

export async function audit({ api, repo, event, branch, requireApproval = false, sleep = realSleep }) {
  const rows = [];
  const violations = [];
  if (event.forced) violations.push(`force push to ${branch} rewrote history (previous head ${short(event.before)})`);

  const { commits, created, note } = await pushedCommits(api, repo, event);
  const perPull = new Map();
  for (const sha of commits) {
    const pr = await mergedPullFor(api, repo, sha, branch, { sleep });
    if (!pr) {
      if (created) rows.push({ sha, pr: null, result: "initial push, not audited" });
      else {
        rows.push({ sha, pr: null, result: "❌ not from a merged pull request" });
        violations.push(`${short(sha)} did not come from a merged pull request`);
      }
      continue;
    }
    if (!perPull.has(pr.number)) {
      const checks = await checksOf(api, repo, pr.head.sha, pr.merged_at);
      const approved = await approvedByOther(api, repo, pr);
      const problems = [];
      if (!checks.total) problems.push("no checks ran on the PR head");
      if (checks.failing.length) problems.push(`failing: ${checks.failing.join(", ")}`);
      if (checks.pending.length) problems.push(`not finished at merge: ${checks.pending.join(", ")}`);
      if (requireApproval && !approved) problems.push("no approving review by someone other than the author");
      perPull.set(pr.number, { checks, approved, problems });
    }
    const { checks, approved, problems } = perPull.get(pr.number);
    rows.push({ sha, pr: pr.number, checks: checks.total, approved, result: problems.length ? `❌ ${problems.join("; ")}` : "✅ ok" });
    if (problems.length) violations.push(`${short(sha)} (#${pr.number}): ${problems.join("; ")}`);
  }
  return { rows, violations, note };
}

export function renderReport({ rows, violations, note }, { repo, branch, after }) {
  const lines = [
    `## Change audit: ${branch} @ ${short(after)}`,
    "",
    "| Commit | Pull request | Checks | Approved by another person | Result |",
    "| --- | --- | --- | --- | --- |",
    ...rows.map((r) => `| ${short(r.sha)} | ${r.pr ? `#${r.pr}` : "—"} | ${r.checks ?? "—"} | ${r.approved === undefined ? "—" : r.approved ? "yes" : "no"} | ${r.result} |`),
  ];
  if (note) lines.push("", `Note: ${note}.`);
  lines.push("", violations.length ? `**${violations.length} change-control exception(s).** Review each one and record the justification on this issue.` : "All audited commits came from merged pull requests with green checks.");
  if (violations.length) lines.push("", ...violations.map((v) => `- ${v}`));
  lines.push("", `Repository: ${repo}. Control: SOC 2 CC8.1, ISO 27001 A.8.32 (ideal-agentic-env/governance change-audit).`);
  return lines.join("\n");
}

const isMain = Boolean(process.argv[1]) && realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url));
if (isMain) {
  try {
    const event = JSON.parse(readFileSync(process.env.GITHUB_EVENT_PATH, "utf8"));
    const repo = process.env.GITHUB_REPOSITORY;
    const branch = String(process.env.GITHUB_REF ?? "").replace(/^refs\/heads\//, "");
    const api = makeApi({ token: process.env.GITHUB_TOKEN, base: process.env.GITHUB_API_URL || "https://api.github.com" });
    const result = await audit({ api, repo, event, branch, requireApproval: process.env.REQUIRE_APPROVAL === "true" });
    const report = renderReport(result, { repo, branch, after: event.after });
    console.log(report);
    if (process.env.GITHUB_STEP_SUMMARY) appendFileSync(process.env.GITHUB_STEP_SUMMARY, `${report}\n`);
    if (result.violations.length) {
      if (process.env.OPEN_ISSUE === "true") {
        const issue = await api(`/repos/${repo}/issues`, {
          method: "POST",
          body: { title: `[change-control] ${result.violations.length} exception(s) on ${branch} at ${short(event.after)}`, body: report },
        });
        console.log(`Opened ${issue.html_url}`);
      }
      for (const v of result.violations) console.log(`::error::${v}`);
      process.exit(1);
    }
  } catch (err) {
    console.error(`change-audit: ${err.message}`);
    process.exit(2);
  }
}
